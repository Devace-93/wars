# Copy to .env for the docker compose stack (deploy/docker-compose.yml).
ACCOUNTS_URL=https://accounts.3m4.net
ACCOUNTS_INTERNAL_URL=https://accounts.3m4.net
GUEST_SIGNING_KEY=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:8086
RUST_LOG=info
# Feature flags (exp.3m4.net). Leave EXP_CLIENT_KEY empty to open the browser client
# to everyone; set it to gate /play/ behind the boolean flag PLAY_FLAG (plus the json
# flag "<PLAY_FLAG>-testers": a list of account handles let in while it is off).
EXP_URL=https://exp.3m4.net
EXP_CLIENT_KEY=
PLAY_FLAG=wars-play
